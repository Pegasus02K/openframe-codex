# Configuration schema version; OpenFrame product version is set per profile.
version: 4

# Copy this file to openframe.local.yaml, then replace the example
# values with paths and connection settings for your own environment.
# Keep openframe.local.yaml private; do not put real credentials in this sample.
# environments is a map keyed by unique profile names, not connection types.
# Put properties directly under each name; do not add name/attributes wrappers.
# Selection follows the root AGENTS.md:
#   - An explicit name (e.g. of73mvs) selects that exact key.
#   - Without a name, match all supplied properties (e.g. 7.3 + MVS).
#   - One match: report the selected name and proceed.
#   - Multiple or no matches, or a name/property conflict: ask the user.
#   - Use default_environment only when neither a name nor properties are given.
# Reject duplicate profile keys, missing required properties, and a default
# that does not name an existing profile. Omitted selection properties are
# unconstrained; do not infer them from profile names.
# Per-profile properties:
#   version: "7.3" or "7.4" (quote the product version)
#   os: MVS, MSP, XSP, or VOS3
#   rdb: tibero for 7.3; tibero or oracle for 7.4
#   rdb_connect_string: selected RDB connection string
# For 7.4, env_path must set SOURCE_BASE to the ofsrc.git clone root.
default_environment: "of73msp"
manual_base: "C:/path/to/Tmax/manual"

environments:
  of73mvs_local:
    type: "local"
    version: "7.3"
    os: "MVS"
    rdb: "tibero"
    env_path: "C:/path/to/openframe-env.ps1"
    # Add this only when the local environment needs direct RDB access.
    # rdb_connect_string: "user/password"

  of73msp:
    type: "remote"
    version: "7.3"
    os: "MSP"
    rdb: "tibero"
    env_path: "/path/to/env_of73_msp_tb"
    ssh_address: "user@example-host"
    ssh_private_key: "C:/path/to/private-key.pem"
    rdb_connect_string: "user/password@database-alias"

  of73mvs:
    type: "remote"
    version: "7.3"
    os: "MVS"
    rdb: "tibero"
    env_path: "/path/to/env_of73_mvs_tb"
    ssh_address: "user@example-host"
    # Set one or both. When both exist, the key is used for SSH and the
    # password is reserved for interactive authentication such as sudo.
    ssh_private_key: "C:/path/to/private-key.pem"
    ssh_password: "password"
    rdb_connect_string: "user/password@database-alias"

  of74mvs_ora_container:
    type: "remote_container"
    version: "7.4"
    os: "MVS"
    rdb: "oracle"
    env_path: "/path/to/openframe/environment-file"
    ssh_address: "user@example-host"
    # Set one or both, using the same precedence as the remote profile.
    ssh_private_key: "C:/path/to/private-key.pem"
    ssh_password: "password"
    of_container_name: "openframe-container"
    rdb_connect_string: "user/password@database-alias"
