version: 4

# Copy this file to .agents/openframe.local.yaml, then replace the example
# values with paths and connection settings for your own environment.
# Keep openframe.local.yaml private; do not put real credentials in this sample.
default_environment: "local"
manual_base: "C:/path/to/Tmax/manual"

environments:
  local:
    type: "local"
    env_path: "C:/path/to/openframe-env.ps1"
    # Add this only when the local environment needs direct Tibero access.
    # tibero_connect_string: "user/password"

  remote:
    type: "remote"
    env_path: "/path/to/openframe/environment-file"
    ssh_address: "user@example-host"
    # Set one or both. When both exist, the key is used for SSH and the
    # password is reserved for interactive authentication such as sudo.
    ssh_private_key: "C:/path/to/private-key.pem"
    ssh_password: "password"
    tibero_connect_string: "user/password"

  remote_container:
    type: "remote_container"
    env_path: "/path/to/openframe/environment-file"
    ssh_address: "user@example-host"
    # Set one or both, using the same precedence as the remote profile.
    ssh_private_key: "C:/path/to/private-key.pem"
    ssh_password: "password"
    of_container_name: "openframe-container"
    tibero_connect_string: "user/password"
